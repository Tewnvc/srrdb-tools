// ==UserScript==
// @name         Rutracker: заготовки текстов
// @namespace    local.rutracker.templates
// @version      1.2
// @description  Выпадающее меню с готовыми текстами возле поля ответа
// @match        https://rutracker.org/forum/viewtopic.php*
// @match        https://rutracker.org/forum/posting.php*
// @grant        none
// ==/UserScript==

(function () {
  'use strict';

  // 'Название в меню': 'Текст для вставки' (\n — перенос строки)
  const TEMPLATES = {
    'Обновление':   'Обновлено до v',
    'R.G.GOGFAN':   'Обновлено до v\nСпасибо [b]R.G.GOGFAN[/b]',
    'alter_go':     'Обновлено до v\nСпасибо [b]R.G.GOGFAN[/b] и [b]alter_go[/b]',
    'deuce0':       'Обновлено до v\nСпасибо [b]deuce0[/b]',
    'Поглощение':   '[b][color=#996600]∑[/color] поглощено[/b]',
  };

  const ta = document.querySelector('#post-textarea');
  if (!ta) return;

  const select = document.createElement('select');
  select.style.cssText = 'display:block; margin:0 auto 4px auto; padding:2px; max-width:100%;';

  select.appendChild(new Option('— Заготовки —', ''));
  for (const label of Object.keys(TEMPLATES)) {
    select.appendChild(new Option(label, label));
  }

  select.addEventListener('change', () => {
    const text = TEMPLATES[select.value];
    if (!text) return;

    const start = ta.selectionStart;
    const end = ta.selectionEnd;
    ta.value = ta.value.slice(0, start) + text + ta.value.slice(end);

    const pos = start + text.length;
    ta.setSelectionRange(pos, pos);
    ta.focus();
    ta.dispatchEvent(new Event('input', { bubbles: true }));

    select.selectedIndex = 0; // сброс меню
  });

  ta.parentNode.insertBefore(select, ta);
})();
